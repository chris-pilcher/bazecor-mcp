                "layer": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "required": ["kind", "layer", "name"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "layer_copy"
                },
                "from": {
                  "type": "integer",
                  "minimum": 0
                },
                "to": {
                  "type": "integer",
                  "minimum": 0
                },
                "colors": {
                  "type": "boolean"
                }
              },
              "required": ["kind", "from", "to"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "layer_reset"
                },
                "layer": {
                  "type": "integer",
                  "minimum": 0
                },
                "source": {
                  "type": "string",
                  "enum": ["transparent", "disabled", "firmware_default"]
                },
                "defaultLayer": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": ["kind", "layer", "source"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "macro_put"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string",
                  "maxLength": 128
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "number",
                            "const": 1
                          },
                          "keyCode": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 65535
                              },
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 65535
                              }
                            ]
                          }
                        },
                        "required": ["type", "keyCode"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "number",
                            "enum": [2, 3, 4, 5]
                          },
                          "keyCode": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65535
                          }
                        },
                        "required": ["type", "keyCode"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "number",
                            "enum": [6, 7, 8]
                          },
                          "keyCode": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                          }
                        },
                        "required": ["type", "keyCode"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "maxItems": 4096
                }
              },
              "required": ["kind", "index", "name", "actions"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "macro_delete"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": ["kind", "index"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "superkey_put"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string",
                  "maxLength": 128
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "minItems": 5,
                  "maxItems": 5
                }
              },
              "required": ["kind", "index", "name", "actions"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "superkey_delete"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": ["kind", "index"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "setting"
                },
                "name": {
                  "type": "string",
                  "maxLength": 100
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "maxLength": 128
                    }
                  ]
                }
              },
              "required": ["kind", "name", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "selection"
                },
                "layer": {
                  "type": "integer",
                  "minimum": 0
                },
                "key": {
                  "type": "integer",
                  "minimum": 0
                },
                "led": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": ["kind", "layer"],
              "additionalProperties": false
            }
          ]
        },
        "minItems": 1,
        "maxItems": 256
      }
    },
    "required": ["expectedRevision", "edits"],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
