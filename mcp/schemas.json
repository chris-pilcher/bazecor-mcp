  "batch": {
    "type": "object",
    "properties": {
      "expectedRevision": {
        "type": "string"
      },
      "edits": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "key"
                },
                "layer": {
                  "type": "integer",
                  "minimum": 0
                },
                "key": {
                  "type": "integer",
                  "minimum": 0
                },
                "keyCode": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              },
              "required": ["kind", "layer", "key", "keyCode"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "color"
                },
                "layer": {
                  "type": "integer",
                  "minimum": 0
                },
                "led": {
                  "type": "integer",
                  "minimum": 0
                },
                "palette": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": ["kind", "layer", "led", "palette"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "color_side"
                },
                "layer": {
                  "type": "integer",
                  "minimum": 0
                },
                "side": {
                  "type": "string",
                  "enum": ["left", "right", "both"]
                },
                "area": {
                  "type": "string",
                  "enum": ["keys", "underglow", "all"]
                },
                "palette": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": ["kind", "layer", "side", "area", "palette"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "action"
                },
                "layer": {
                  "type": "integer",
                  "minimum": 0
                },
                "key": {
                  "type": "integer",
                  "minimum": 0
                },
                "actionId": {
                  "type": "string",
                  "pattern": "^keycode:\\d+$"
                }
              },
              "required": ["kind", "layer", "key", "actionId"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "palette"
                },
                "slot": {
                  "type": "integer",
                  "minimum": 0
                },
                "color": {
                  "type": "object",
                  "properties": {
                    "r": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "g": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "b": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    }
                  },
                  "required": ["r", "g", "b"],
                  "additionalProperties": false
                }
              },
              "required": ["kind", "slot", "color"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "color_bulk"
                },
                "layer": {
                  "type": "integer",
                  "minimum": 0
                },
                "leds": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 1,
                  "maxItems": 1024
                },
                "palette": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": ["kind", "layer", "leds", "palette"],
              "additionalProperties": false
            },
